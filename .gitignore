# Data files - Audio files (全局忽略，但 remote/remote-v2/data 目录特殊处理)
*.wav
*.mp3
*.flac
*.aac
*.ogg
*.m4a

# remote/remote-v2/data 目录：允许所有非音频文件上传
# 先取消对该目录下所有文件的忽略（覆盖全局音频文件忽略规则）
!remote/remote-v2/data/
!remote/remote-v2/data/**
# 然后只忽略该目录下的音频文件
remote/remote-v2/data/**/*.wav
remote/remote-v2/data/**/*.mp3
remote/remote-v2/data/**/*.flac
remote/remote-v2/data/**/*.aac
remote/remote-v2/data/**/*.ogg
remote/remote-v2/data/**/*.m4a

# 其他 data 目录的音频文件（保持原有行为）
